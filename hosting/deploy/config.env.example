# Copy to config.env and fill in for your environment. Sourced by the deploy
# scripts. config.env is gitignored (it's environment-specific).
#
# This serves the installer PUBLICLY at:
#   https://platform.prod.internal.paraframes.org/install.sh
#   https://platform.edu.internal.paraframes.org/install.sh
# so it works from anywhere (e.g. your personal Mac). "internal" is just part of
# the name — the record is created in your PUBLIC paraframes.org DNS zone.

PROJECT=paraframes-app          # GCP project
ZONE=us-east1-b                 # VM zone
VPC=default                     # VPC network
SUBNET=default                  # subnet in $ZONE's region (optional)
VM_NAME=paraclient-web          # the install-endpoint VM
MACHINE_TYPE=e2-micro           # cheapest; plenty for serving 3 static files

# TLS: Let's Encrypt needs a real email for the account / expiry notices.
CERTBOT_EMAIL=abalakrishnan@glia-ai.com

# Optional: if set, provision-vm.sh also creates/updates the public A records.
# Must be your existing PUBLIC Cloud DNS zone for paraframes.org.
# Leave blank if your public DNS is managed elsewhere (add records by hand).
DNS_ZONE=

# The two hostnames served (prod + edu). Change only if your naming differs.
HOST_PROD=platform.prod.internal.paraframes.org
HOST_EDU=platform.edu.internal.paraframes.org
