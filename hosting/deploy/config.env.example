# Copy to config.env and fill in for your environment. Sourced by provision-vm.sh
# and deploy.sh. config.env is gitignored (it's environment-specific).

PROJECT=paraframes-app          # GCP project
ZONE=us-east1-b                 # VM zone
VPC=default                     # VPC network the VM + clients live on
SUBNET=default                  # subnet in $ZONE's region (optional; omit to let GCP pick)
VM_NAME=paraclient-web          # the install-endpoint VM
MACHINE_TYPE=e2-micro           # cheapest; plenty for serving 3 static files

# Who may reach the VM over 80/443 (clients that run the installer).
# Narrow this to your VPC/CIDR — default is the whole private range.
ALLOW_CIDR=10.0.0.0/8

# Optional: if set, provision-vm.sh also creates/updates the A records.
# Must be an existing PRIVATE Cloud DNS zone for internal.paraframes.org
DNS_ZONE=paraframes-internal
